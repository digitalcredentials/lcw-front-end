# Base URL of the backend API (no trailing slash)
# Local: the sam local API from lcw-back-end (sam local start-api --port 3001)
# Deployed: https://iibe16rs13.execute-api.us-east-1.amazonaws.com
VITE_API_BASE_URL=http://127.0.0.1:3001

# Set to true to use a client-side placeholder for /api/files
VITE_USE_MOCK_FILES_API=true

# Base URL of the credential-templates API (no trailing slash); feeds the
# batch issuer's template dropdown.
VITE_TEMPLATES_API_BASE=http://127.0.0.1:3002

# Base URL of the test issuer API (aws-lambda-issuer HTTP API, no trailing
# slash); the welcome credential is requested from {base}/workflows/....
VITE_ISSUER_API_BASE=https://ko29d8ljta.execute-api.us-east-1.amazonaws.com

# Base URL of the batch issuer API (batch-issuer-backend HTTP API, no trailing
# slash); the batch issuer's Notify recipients posts to {base}/notify.
VITE_BATCH_API_BASE=

# Base URL of the WAS server, which owns the /spaces registry endpoints
VITE_WAS_BASE_URL=http://localhost:3000

# Base URL of the Bitstring Status List service
VITE_STATUS_API_BASE=https://status.lcw-sandbox.org

# The identity domain the account did:webvh names (did:webvh:{scid}:{domain}:{spaceId});
# the was-server stack serves it in front of the PWS server.
VITE_ID_DOMAIN=id.lcw-sandbox.org

# Used by `npm run build` (production mode); .env keeps the local dev values.
# Base URL of the deployed lcw-back-end API (no trailing slash)
# api.lcw-sandbox.org is the custom domain for the lcw-back-end HTTP API
VITE_API_BASE_URL=https://api.lcw-sandbox.org

VITE_USE_MOCK_FILES_API=false

# Base URL of the deployed credential-templates API (no trailing slash)
VITE_TEMPLATES_API_BASE=https://f1exkuo3g0.execute-api.us-east-1.amazonaws.com/Prod

# Base URL of the deployed issuer API (no trailing slash)
VITE_ISSUER_API_BASE=https://ko29d8ljta.execute-api.us-east-1.amazonaws.com

# Base URL of the WAS server, which owns the /spaces registry endpoints
VITE_WAS_BASE_URL=https://was.lcw-sandbox.org
